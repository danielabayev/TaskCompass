# Copy to .env and fill in. .env is never committed.

# Anthropic API key dedicated to this tool.
ANTHROPIC_API_KEY=

# PostgreSQL (used by docker-compose.yml and by the app).
POSTGRES_USER=task_compass
POSTGRES_PASSWORD=
POSTGRES_DB=task_compass
# Host port. Not 5432, so it does not clash with other Postgres containers.
POSTGRES_PORT=5433
# 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 first and every
# new connection waits about 2 seconds before falling back.
POSTGRES_HOST=127.0.0.1

# Local monthly spend cap in USD. The tool stops calling the model once reached.
MONTHLY_COST_CAP_USD=10

# Debug: store the full prompt and reply of every model call, shown on each
# task's "model calls" page. Stores everything you type; leave off unless needed.
DEBUG_LOG_CALLS=false
